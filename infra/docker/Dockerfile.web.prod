# ==============================================================================
# J3D Web (Next.js 15 App Router + Three.js) Production Dockerfile
# ==============================================================================
FROM node:20-slim AS builder

WORKDIR /app

# Copy root package manifests and workspace definitions
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/

# Install all dependencies for build
RUN npm ci

# Copy shared-types and build
COPY packages/shared-types ./packages/shared-types
RUN npm run build --workspace=@j3d/shared-types

# Copy Web application source
COPY apps/web ./apps/web

# Next.js build arguments
ARG NEXT_PUBLIC_SITE_URL="https://j3d.msoms.ai"
ARG NEXT_PUBLIC_API_URL="https://j3d.msoms.ai/api/v1"
ARG NEXT_PUBLIC_WS_URL="https://j3d.msoms.ai"
ARG NEXT_PUBLIC_APP_VERSION="v1.0.0-prod"
ARG NEXT_PUBLIC_BUILD_DATE="2026-11-24T00:00:00Z"
ARG NEXT_PUBLIC_GITHUB_REPO="https://github.com/msoms-ai/j3d"

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION
ENV NEXT_PUBLIC_BUILD_DATE=$NEXT_PUBLIC_BUILD_DATE
ENV NEXT_PUBLIC_GITHUB_REPO=$NEXT_PUBLIC_GITHUB_REPO

WORKDIR /app/apps/web
RUN npm run build

# ------------------------------------------------------------------------------
# Production Runtime Stage
# ------------------------------------------------------------------------------
FROM node:20-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# Copy root package manifests
COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/web/package.json ./apps/web/

# Install production dependencies only
RUN npm ci --omit=dev

# Copy build artifacts
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/messages ./apps/web/messages
COPY --from=builder /app/apps/web/next.config.mjs ./apps/web/next.config.mjs

WORKDIR /app/apps/web

EXPOSE 3000

CMD ["npm", "run", "start"]
