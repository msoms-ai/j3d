# ==============================================================================
# J3D Platform (.env.example) — msoms.ai 2026 Initiative
# Production Domain: https://j3d.msoms.ai
# ==============================================================================

NODE_ENV="development"
PORT_WEB="3000"
PORT_API="4000"

NEXT_PUBLIC_SITE_URL="https://j3d.msoms.ai"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

NEXT_PUBLIC_APP_VERSION="v1.0.0-local"
NEXT_PUBLIC_BUILD_DATE="2026-11-07T12:00:00Z"
NEXT_PUBLIC_GITHUB_REPO="https://github.com/msoms-ai/j3d"

# Database & Cache (PostgreSQL 16 & Redis 7.4)
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL="postgresql://j3d_admin:j3d_dev_password@localhost:5432/j3d_platform?schema=public"
REDIS_URL="redis://localhost:6379"

# Cryptographic Secrets (64-character hex strings)
JWT_ACCESS_SECRET="replace-with-64-character-hex-string"
JWT_REFRESH_SECRET="replace-with-64-character-hex-string"
MASTER_ENCRYPTION_KEY="replace-with-64-character-hex-string"

# Google Gemini AI (@google/genai)
DEFAULT_GEMINI_API_KEY="AIzaSyYourGeminiKeyHere"
DEFAULT_GEMINI_TEXT_MODEL="gemini-4-hydrogen"
DEFAULT_GEMINI_IMAGE_MODEL="imagen-3.0-generate-002"

# Resend Transactional Email
DEFAULT_RESEND_API_KEY="re_YourResendKeyHere"
DEFAULT_SENDER_EMAIL="noreply@msoms.ai"
DEFAULT_SENDER_NAME="J3D Platform"

# Ziina UAE Payment Gateway
ZIINA_API_KEY="YourZiinaApiKeyHere"
ZIINA_API_BASE_URL="https://api-v2.ziina.com/api"

# MinIO S3 Object Storage
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="j3d-assets"
S3_ACCESS_KEY="j3d_minio_user"
S3_SECRET_KEY="j3d_minio_password"
S3_PUBLIC_BASE_URL="http://localhost:9000/j3d-assets"

OSM_NOMINATIM_USER_AGENT="j3d.msoms.ai/1.0 (noreply@msoms.ai)"
